# Bootstrap & Internal System Keys
BOOTSTRAP_SECRET=YOUR_RANDOM_INITIAL_BOOTSTRAP_SECRET_KEY
INTERNAL_DEV_KEY=YOUR_OPTIONAL_INTERNAL_SERVICE_KEY

# Cloudinary Media Storage (Optional - Required for Logo / Avatar Uploads)
